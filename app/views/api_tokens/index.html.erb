<div class="p-6">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">API Tokens</h1>
    <p class="text-sm text-gray-500 mb-6">Generate tokens for AI agents (Claude Code, Codex, etc.) to access your tasks via the API.</p>

    <!-- New token created -->
    <% if flash[:token] %>
      <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
        <p class="text-sm font-medium text-green-800 mb-2">Your new API token (copy it now - it won't be shown again!):</p>
        <div class="flex items-center gap-2">
          <code class="flex-1 bg-white px-3 py-2 rounded border border-green-300 text-sm font-mono text-green-900 select-all"><%= flash[:token] %></code>
        </div>
        <p class="text-xs text-green-600 mt-2">Use as: <code>Authorization: Bearer &lt;token&gt;</code></p>
      </div>
    <% end %>

    <!-- Create token form -->
    <div class="bg-white rounded-lg border border-gray-200 p-4 mb-6">
      <%= form_with model: ApiToken.new, url: api_tokens_path, class: "flex items-end gap-3" do |f| %>
        <div class="flex-1">
          <%= f.label :name, "Token name", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :name, placeholder: "e.g., Claude Code Token", required: true,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
        </div>
        <%= f.submit "Generate Token", class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 cursor-pointer whitespace-nowrap" %>
      <% end %>
    </div>

    <!-- Token list -->
    <div class="bg-white rounded-lg border border-gray-200 divide-y divide-gray-200">
      <% if @api_tokens.empty? %>
        <div class="p-8 text-center text-sm text-gray-500">No API tokens yet.</div>
      <% else %>
        <% @api_tokens.each do |token| %>
          <div class="flex items-center justify-between p-4">
            <div>
              <p class="text-sm font-medium text-gray-900"><%= token.name %></p>
              <div class="flex items-center gap-3 text-xs text-gray-400 mt-1">
                <span>Prefix: <code><%= token.prefix %>...</code></span>
                <span>Created: <%= token.created_at.strftime("%b %d, %Y") %></span>
                <% if token.last_used_at %>
                  <span>Last used: <%= time_ago_in_words(token.last_used_at) %> ago</span>
                <% else %>
                  <span>Never used</span>
                <% end %>
              </div>
            </div>
            <%= button_to "Revoke", api_token_path(token), method: :delete,
                class: "text-sm text-red-600 hover:text-red-800",
                data: { turbo_confirm: "Revoke this token? Any agents using it will lose access." } %>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- Usage instructions -->
    <div class="mt-8 bg-gray-50 rounded-lg p-4">
      <h3 class="text-sm font-semibold text-gray-700 mb-2">API Usage</h3>
      <div class="text-xs text-gray-500 space-y-2 font-mono">
        <p># List projects</p>
        <p class="text-gray-700">curl -H "Authorization: Bearer YOUR_TOKEN" http://localhost:3000/api/v1/projects</p>
        <p class="mt-2"># Create a task</p>
        <p class="text-gray-700">curl -X POST -H "Authorization: Bearer YOUR_TOKEN" -H "Content-Type: application/json" \<br>
          &nbsp;&nbsp;-d '{"task":{"title":"My task","priority":"high"}}' \<br>
          &nbsp;&nbsp;http://localhost:3000/api/v1/projects/1/tasks</p>
      </div>
    </div>
  </div>
</div>
