<div class="p-6">
  <div class="max-w-2xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Members</h1>
        <p class="text-sm text-gray-500 mt-1"><%= @project.name %></p>
      </div>
      <%= link_to "Back to Board", project_board_path(@project),
          class: "text-sm text-indigo-600 hover:text-indigo-800" %>
    </div>

    <!-- Owner -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm mb-6">
      <div class="px-4 py-3 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-700">Owner</h2>
      </div>
      <div class="px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-sm font-medium"
               style="background-color: <%= @project.user.avatar_color %>">
            <%= @project.user.name.first.upcase %>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-900"><%= @project.user.name %></p>
            <p class="text-xs text-gray-500"><%= @project.user.email_address %></p>
          </div>
        </div>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800">
          Owner
        </span>
      </div>
    </div>

    <!-- Members -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm mb-6">
      <div class="px-4 py-3 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-700">Members (<%= @members.count %>)</h2>
      </div>

      <% if @members.any? %>
        <% @members.each do |member| %>
          <div class="px-4 py-3 flex items-center justify-between border-b border-gray-50 last:border-0">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-sm font-medium"
                   style="background-color: <%= member.user.avatar_color %>">
                <%= member.user.name.first.upcase %>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-900"><%= member.user.name %></p>
                <p class="text-xs text-gray-500"><%= member.user.email_address %></p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium
                <%= case member.role
                    when 'owner' then 'bg-purple-100 text-purple-800'
                    when 'editor' then 'bg-blue-100 text-blue-800'
                    when 'viewer' then 'bg-gray-100 text-gray-700'
                    end %>">
                <%= member.role.capitalize %>
              </span>
              <%= button_to project_member_path(@project, member), method: :delete,
                  class: "text-red-500 hover:text-red-700",
                  data: { turbo_confirm: "Remove #{member.user.name} from this project?" } do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="px-4 py-6 text-center text-sm text-gray-500">
          No members yet. Add someone below.
        </div>
      <% end %>
    </div>

    <!-- Add Member -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm">
      <div class="px-4 py-3 border-b border-gray-100">
        <h2 class="text-sm font-semibold text-gray-700">Add Member</h2>
      </div>
      <div class="px-4 py-4">
        <%= form_with url: project_members_path(@project), method: :post, class: "flex items-end gap-3" do |f| %>
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 mb-1">Email address</label>
            <%= f.email_field :email_address, placeholder: "user@example.com",
                class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
            <%= f.select :role, [["Viewer", "viewer"], ["Editor", "editor"], ["Owner", "owner"]],
                {}, class: "rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
          </div>
          <%= f.submit "Add",
              class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
