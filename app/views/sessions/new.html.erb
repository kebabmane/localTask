<div class="min-h-screen flex items-center justify-center bg-gray-50">
  <div class="w-full max-w-md">
    <div class="bg-white shadow-lg rounded-lg px-8 py-10">
      <div class="text-center mb-6">
        <div class="w-12 h-12 bg-indigo-500 rounded-lg flex items-center justify-center font-bold text-white text-lg mx-auto mb-3">LT</div>
        <h1 class="text-2xl font-bold text-gray-900">Sign in to LocalTask</h1>
      </div>

      <%= form_with url: session_url, class: "space-y-5" do |form| %>
        <% if flash[:alert] %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-3">
            <p class="text-sm text-red-700"><%= flash[:alert] %></p>
          </div>
        <% end %>

        <div>
          <%= form.label :email_address, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              value: params[:email_address],
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= form.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>

        <%= form.submit "Sign in",
            class: "w-full py-2.5 px-4 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 cursor-pointer" %>
      <% end %>

      <div class="mt-6 text-center space-y-2">
        <p class="text-sm text-gray-500">
          Don't have an account?
          <%= link_to "Sign up", new_registration_path, class: "text-indigo-600 hover:text-indigo-500 font-medium" %>
        </p>
        <p class="text-sm">
          <%= link_to "Forgot password?", new_password_path, class: "text-gray-500 hover:text-gray-700" %>
        </p>
      </div>
    </div>
  </div>
</div>
