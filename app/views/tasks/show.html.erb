<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 overflow-hidden" data-controller="slideover">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-gray-500/50" data-action="click->slideover#close"></div>

    <!-- Panel -->
    <div class="absolute inset-y-0 right-0 w-full max-w-2xl bg-white shadow-xl flex flex-col">
      <!-- Header -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
        <div class="flex items-center gap-3">
          <span class="text-sm font-mono text-gray-400"><%= @task.display_id %></span>
          <span class="px-2 py-0.5 text-xs rounded-full text-white" style="background-color: <%= @task.task_status.color %>">
            <%= @task.task_status.name %>
          </span>
          <% if @task.agent_identifier.present? %>
            <span class="px-2 py-0.5 text-xs rounded bg-amber-100 text-amber-700"><%= @task.agent_identifier %></span>
          <% end %>
        </div>
        <%= link_to project_board_path(@project), class: "text-gray-400 hover:text-gray-600", data: { turbo_frame: "modal" } do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        <% end %>
      </div>

      <!-- Content -->
      <div class="flex-1 overflow-y-auto p-6 space-y-6">
        <div>
          <h2 class="text-xl font-bold text-gray-900 mb-2"><%= @task.title %></h2>
          <% if @task.description.present? %>
            <div class="prose prose-sm text-gray-600"><%= simple_format(@task.description) %></div>
          <% end %>
        </div>

        <!-- Details grid -->
        <div class="grid grid-cols-2 gap-4 text-sm">
          <div>
            <span class="text-gray-500 block mb-1">Priority</span>
            <span class="px-2 py-0.5 rounded text-xs font-medium
              <%= case @task.priority
                  when 'critical' then 'bg-red-100 text-red-700'
                  when 'high' then 'bg-orange-100 text-orange-700'
                  when 'medium' then 'bg-blue-100 text-blue-700'
                  else 'bg-gray-100 text-gray-700'
                  end %>">
              <%= @task.priority.titleize %>
            </span>
          </div>
          <div>
            <span class="text-gray-500 block mb-1">Status</span>
            <%= form_with url: project_task_path(@project, @task), method: :patch, class: "inline" do |f| %>
              <%= f.select :task_status_id, @project.task_statuses.ordered.map { |s| [s.name, s.id] },
                  { selected: @task.task_status_id },
                  class: "text-sm rounded-lg border-gray-300", data: { action: "change->this#submit" } %>
            <% end %>
          </div>
          <div>
            <span class="text-gray-500 block mb-1">Assignee</span>
            <span class="text-gray-900"><%= @task.assignee&.name || "Unassigned" %></span>
          </div>
          <div>
            <span class="text-gray-500 block mb-1">Due Date</span>
            <span class="text-gray-900 <%= @task.due_date && @task.due_date < Date.today ? 'text-red-600' : '' %>">
              <%= @task.due_date&.strftime("%B %d, %Y") || "No due date" %>
            </span>
          </div>
          <div>
            <span class="text-gray-500 block mb-1">Created</span>
            <span class="text-gray-900"><%= @task.created_at.strftime("%b %d, %Y %H:%M") %></span>
          </div>
          <div>
            <span class="text-gray-500 block mb-1">Creator</span>
            <span class="text-gray-900"><%= @task.creator.name %></span>
          </div>
        </div>

        <!-- Dependencies -->
        <% if @task.dependencies.any? || @task.dependents.any? %>
          <div>
            <h3 class="text-sm font-semibold text-gray-700 mb-2">Dependencies</h3>
            <% @task.dependencies.each do |dep| %>
              <div class="flex items-center gap-2 text-sm text-gray-600 mb-1">
                <span class="text-red-500">blocked by</span>
                <%= link_to "#{dep.display_id}: #{dep.title}", project_task_path(@project, dep),
                    class: "text-indigo-600 hover:text-indigo-800", data: { turbo_frame: "modal" } %>
              </div>
            <% end %>
            <% @task.dependents.each do |dep| %>
              <div class="flex items-center gap-2 text-sm text-gray-600 mb-1">
                <span class="text-green-500">blocks</span>
                <%= link_to "#{dep.display_id}: #{dep.title}", project_task_path(@project, dep),
                    class: "text-indigo-600 hover:text-indigo-800", data: { turbo_frame: "modal" } %>
              </div>
            <% end %>
          </div>
        <% end %>

        <!-- Attachments -->
        <% if @task.attachments.any? %>
          <div>
            <h3 class="text-sm font-semibold text-gray-700 mb-2">Attachments</h3>
            <div class="flex flex-wrap gap-2">
              <% @task.attachments.each do |attachment| %>
                <% if attachment.image? %>
                  <%= link_to rails_blob_path(attachment, disposition: "inline"), target: "_blank", class: "block" do %>
                    <%= image_tag attachment.variant(resize_to_limit: [200, 200]), class: "rounded-lg border border-gray-200" %>
                  <% end %>
                <% else %>
                  <%= link_to rails_blob_path(attachment, disposition: "attachment"), class: "flex items-center gap-2 px-3 py-2 bg-gray-50 rounded-lg border border-gray-200 text-sm text-gray-600 hover:bg-gray-100" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
                    </svg>
                    <%= attachment.filename %>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Comments -->
        <div>
          <h3 class="text-sm font-semibold text-gray-700 mb-3">Activity</h3>
          <div id="comments" class="space-y-3 mb-4">
            <% @task.comments.each do |comment| %>
              <%= render "comments/comment", comment: comment %>
            <% end %>
          </div>

          <%= form_with model: [@project, @task, Comment.new], class: "space-y-3" do |f| %>
            <%= f.text_area :body, rows: 3, placeholder: "Add a comment...",
                class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
            <div class="flex justify-end">
              <%= f.submit "Comment", class: "px-4 py-1.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 cursor-pointer" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Footer actions -->
      <div class="px-6 py-3 border-t border-gray-200 flex justify-between">
        <%= link_to "Edit", edit_project_task_path(@project, @task), class: "text-sm text-gray-600 hover:text-gray-900" %>
        <%= button_to "Delete", project_task_path(@project, @task), method: :delete,
            class: "text-sm text-red-600 hover:text-red-800",
            data: { turbo_confirm: "Delete this task?" } %>
      </div>
    </div>
  </div>
<% end %>
