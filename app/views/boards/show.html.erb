<%= turbo_stream_from @project %>

<div class="flex flex-col h-full">
  <%= render "shared/toolbar", project: @project %>

  <!-- Kanban columns container -->
  <div class="flex-1 overflow-x-auto">
    <div class="flex gap-4 p-4 h-full min-w-max"
         data-controller="kanban"
         data-kanban-project-id-value="<%= @project.id %>">
      <% @project.task_statuses.ordered.each do |status| %>
        <%= render "boards/column", status: status, tasks: @tasks_by_status[status.id] || [] %>
      <% end %>
    </div>
  </div>
</div>

<%= turbo_frame_tag "modal" %>
