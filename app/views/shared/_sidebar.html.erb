<aside class="w-64 bg-gray-900 text-white flex flex-col shrink-0">
  <!-- Logo -->
  <div class="p-4 border-b border-gray-800">
    <%= link_to root_path, class: "flex items-center gap-2" do %>
      <div class="w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center font-bold text-sm">LT</div>
      <span class="text-lg font-semibold">LocalTask</span>
    <% end %>
  </div>

  <!-- Projects -->
  <nav class="flex-1 overflow-y-auto p-3">
    <div class="flex items-center justify-between mb-2 px-2">
      <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Projects</span>
      <%= link_to new_project_path, class: "text-gray-400 hover:text-white" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
      <% end %>
    </div>

    <% Current.user&.projects&.active&.order(:position)&.each do |project| %>
      <%= link_to project_board_path(project),
          class: "flex items-center gap-2 px-2 py-1.5 rounded-md text-sm #{ @project&.id == project.id ? 'bg-gray-800 text-white' : 'text-gray-300 hover:bg-gray-800 hover:text-white' }" do %>
        <span class="w-3 h-3 rounded-sm shrink-0" style="background-color: <%= project.color %>"></span>
        <span class="truncate"><%= project.name %></span>
      <% end %>
    <% end %>
  </nav>

  <!-- Bottom nav -->
  <div class="p-3 border-t border-gray-800 space-y-1">
    <% if Current.user&.admin? %>
      <%= link_to admin_path, class: "flex items-center gap-2 px-2 py-1.5 rounded-md text-sm text-gray-300 hover:bg-gray-800 hover:text-white" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        Admin
      <% end %>
    <% end %>

    <%= link_to api_tokens_path, class: "flex items-center gap-2 px-2 py-1.5 rounded-md text-sm text-gray-300 hover:bg-gray-800 hover:text-white" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
      </svg>
      API Tokens
    <% end %>

    <div class="flex items-center gap-2 px-2 py-1.5 text-sm text-gray-400">
      <span class="w-6 h-6 rounded-full flex items-center justify-center text-white text-xs" style="background-color: <%= Current.user&.avatar_color %>">
        <%= Current.user&.name&.first&.upcase %>
      </span>
      <span class="truncate flex-1"><%= Current.user&.name %></span>
      <%= button_to "Sign out", session_path, method: :delete, class: "text-gray-400 hover:text-white text-xs" %>
    </div>
  </div>
</aside>
