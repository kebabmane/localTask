<div class="p-6">
  <div class="max-w-lg mx-auto">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Edit Project</h1>
    <%= render "form", project: @project %>

    <div class="mt-8 pt-6 border-t border-gray-200">
      <h3 class="text-sm font-semibold text-red-600 mb-2">Danger Zone</h3>
      <%= button_to "Delete Project", project_path(@project), method: :delete,
          class: "px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700",
          data: { turbo_confirm: "Are you sure? This will delete all tasks and data in this project." } %>
    </div>
  </div>
</div>
