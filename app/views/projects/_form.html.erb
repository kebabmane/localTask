<%= form_with model: project, class: "space-y-5" do |f| %>
  <% if project.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <ul class="text-sm text-red-700 space-y-1">
        <% project.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", autofocus: true, required: true %>
  </div>

  <div>
    <%= f.label :prefix, "Prefix (e.g., LT)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :prefix, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 uppercase", required: true, maxlength: 5, placeholder: "LT" %>
    <p class="mt-1 text-xs text-gray-500">Used for task IDs like LT-1, LT-2. Uppercase letters and numbers only.</p>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :description, rows: 3, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :color, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.color_field :color, class: "w-12 h-10 rounded-lg border-gray-300 shadow-sm cursor-pointer" %>
  </div>

  <%= f.submit project.persisted? ? "Update Project" : "Create Project",
      class: "w-full py-2.5 px-4 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 cursor-pointer" %>
<% end %>
