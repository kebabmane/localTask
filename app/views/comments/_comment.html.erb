<div id="<%= dom_id(comment) %>" class="flex gap-3">
  <% if comment.status_change? %>
    <div class="w-6 h-6 rounded-full bg-gray-200 flex items-center justify-center shrink-0">
      <svg class="w-3 h-3 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"/>
      </svg>
    </div>
    <div class="text-sm text-gray-500 py-1">
      <%= comment.body.gsub(/\*\*(.+?)\*\*/, '\1') %>
      <span class="text-xs text-gray-400 ml-2"><%= time_ago_in_words(comment.created_at) %> ago</span>
    </div>
  <% else %>
    <div class="w-6 h-6 rounded-full flex items-center justify-center text-white text-xs shrink-0"
         style="background-color: <%= comment.user&.avatar_color || '#f59e0b' %>">
      <%= comment.from_agent? ? "AI" : comment.user&.name&.first&.upcase %>
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <span class="text-sm font-medium text-gray-900"><%= comment.author_name %></span>
        <% if comment.from_agent? %>
          <span class="px-1.5 py-0.5 bg-amber-100 text-amber-700 rounded text-xs">Agent</span>
        <% end %>
        <span class="text-xs text-gray-400"><%= time_ago_in_words(comment.created_at) %> ago</span>
      </div>
      <div class="text-sm text-gray-700 prose prose-sm max-w-none"><%= simple_format(comment.body) %></div>

      <% if comment.attachments.any? %>
        <div class="mt-2 flex flex-wrap gap-2">
          <% comment.attachments.each do |attachment| %>
            <% if attachment.image? %>
              <%= link_to rails_blob_path(attachment, disposition: "inline"), target: "_blank" do %>
                <%= image_tag attachment.variant(resize_to_limit: [150, 150]), class: "rounded border border-gray-200" %>
              <% end %>
            <% else %>
              <%= link_to attachment.filename, rails_blob_path(attachment, disposition: "attachment"),
                  class: "text-sm text-indigo-600 hover:text-indigo-800" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
