<div class="p-6">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Agents</h1>
        <p class="text-sm text-gray-500 mt-1">Register AI agents and download MCP configuration files for Claude Code and Claude Desktop.</p>
      </div>
      <%= link_to new_agent_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        Create Agent
      <% end %>
    </div>

    <% if @agents.empty? %>
      <div class="bg-white rounded-lg border border-gray-200 p-12 text-center">
        <div class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <h3 class="text-sm font-medium text-gray-900 mb-1">No agents yet</h3>
        <p class="text-sm text-gray-500 mb-4">Create an agent to get started with MCP integration for Claude Code or Claude Desktop.</p>
        <%= link_to "Create your first agent", new_agent_path, class: "text-sm text-indigo-600 hover:text-indigo-800 font-medium" %>
      </div>
    <% else %>
      <div class="grid gap-4">
        <% @agents.each do |agent| %>
          <%= link_to agent_path(agent), class: "block bg-white rounded-lg border border-gray-200 hover:border-indigo-300 hover:shadow-sm transition p-4" do %>
            <div class="flex items-start justify-between">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-gray-900"><%= agent.name %></h3>
                  <div class="flex items-center gap-2 mt-1">
                    <code class="text-xs bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded font-mono"><%= agent.identifier %></code>
                    <% if agent.api_token&.active? %>
                      <span class="inline-flex items-center text-xs text-green-700 bg-green-50 px-1.5 py-0.5 rounded">Token active</span>
                    <% else %>
                      <span class="inline-flex items-center text-xs text-red-700 bg-red-50 px-1.5 py-0.5 rounded">Token revoked</span>
                    <% end %>
                  </div>
                  <% if agent.description.present? %>
                    <p class="text-xs text-gray-500 mt-1 line-clamp-2"><%= agent.description %></p>
                  <% end %>
                </div>
              </div>
              <span class="text-xs text-gray-400"><%= agent.created_at.strftime("%b %d, %Y") %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
