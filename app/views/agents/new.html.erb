<div class="p-6">
  <div class="max-w-lg mx-auto">
    <div class="mb-6">
      <%= link_to agents_path, class: "text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Agents
      <% end %>
    </div>

    <h1 class="text-2xl font-bold text-gray-900 mb-2">Create Agent</h1>
    <p class="text-sm text-gray-500 mb-6">Register a new AI agent. An API token will be auto-generated for REST API access.</p>

    <div class="bg-white rounded-lg border border-gray-200 p-6">
      <%= form_with model: @agent, url: agents_path, class: "space-y-4" do |f| %>
        <% if @agent.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-3">
            <p class="text-sm font-medium text-red-800">Please fix the following errors:</p>
            <ul class="mt-1 text-sm text-red-600 list-disc list-inside">
              <% @agent.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :name, "Agent Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :name, placeholder: "e.g., Claude Code Agent", required: true, autofocus: true,
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm",
              data: { action: "input->agent-form#generateIdentifier" } %>
          <p class="mt-1 text-xs text-gray-400">A human-readable name for this agent.</p>
        </div>

        <div>
          <%= f.label :identifier, "Identifier", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :identifier, placeholder: "e.g., claude-code-agent",
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm font-mono",
              data: { agent_form_target: "identifier" } %>
          <p class="mt-1 text-xs text-gray-400">Auto-generated from name. Used as <code class="bg-gray-100 px-1 rounded">agent_identifier</code> in MCP tools and API calls. Must be lowercase with hyphens or underscores.</p>
        </div>

        <div>
          <%= f.label :description, "Description", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :description, rows: 3, placeholder: "Optional description of what this agent does...",
              class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
        </div>

        <div class="pt-2">
          <%= f.submit "Create Agent", class: "w-full px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
