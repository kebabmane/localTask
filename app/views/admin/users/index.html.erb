<%= render layout: "admin/shared/layout" do %>
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold text-gray-900">Users (<%= @users.count %>)</h2>
    <%= form_with url: admin_users_path, method: :get, class: "flex items-center gap-2" do %>
      <%= text_field_tag :q, params[:q], placeholder: "Search users...",
          class: "rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm px-3 py-2" %>
      <%= submit_tag "Search", class: "px-3 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 cursor-pointer" %>
    <% end %>
  </div>

  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Projects</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tokens</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Joined</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @users.each do |user| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <div class="flex items-center gap-3">
                <span class="w-7 h-7 rounded-full flex items-center justify-center text-white text-xs shrink-0"
                      style="background-color: <%= user.avatar_color %>">
                  <%= user.name.first.upcase %>
                </span>
                <div>
                  <p class="text-sm font-medium text-gray-900"><%= user.name %></p>
                  <p class="text-xs text-gray-400"><%= user.email_address %></p>
                </div>
              </div>
            </td>
            <td class="px-4 py-3">
              <span class="px-2 py-0.5 text-xs rounded <%= user.admin? ? 'bg-indigo-100 text-indigo-700' : 'bg-gray-100 text-gray-600' %>">
                <%= user.role.titleize %>
              </span>
            </td>
            <td class="px-4 py-3 text-sm text-gray-500"><%= user.projects.size %></td>
            <td class="px-4 py-3 text-sm text-gray-500"><%= user.api_tokens.size %></td>
            <td class="px-4 py-3 text-xs text-gray-400"><%= user.created_at.strftime("%b %d, %Y") %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to "View", admin_user_path(user), class: "text-sm text-indigo-600 hover:text-indigo-800" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
