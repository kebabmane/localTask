<%= render layout: "admin/shared/layout" do %>
  <div class="max-w-lg">
    <div class="flex items-center gap-3 mb-6">
      <%= link_to admin_user_path(@user), class: "text-gray-400 hover:text-gray-600" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
        </svg>
      <% end %>
      <h2 class="text-lg font-semibold text-gray-900">Edit User</h2>
    </div>

    <%= form_with model: @user, url: admin_user_path(@user), class: "space-y-4" do |f| %>
      <div>
        <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
      </div>

      <div>
        <%= f.label :email_address, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email_address, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
      </div>

      <div>
        <%= f.label :role, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :role, User.roles.keys.map { |r| [r.titleize, r] },
            {},
            class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm",
            disabled: @user == Current.user %>
        <% if @user == Current.user %>
          <p class="text-xs text-gray-400 mt-1">You cannot change your own role.</p>
        <% end %>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= f.submit "Save Changes", class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 cursor-pointer" %>
        <%= link_to "Cancel", admin_user_path(@user), class: "px-4 py-2 text-sm text-gray-600 hover:text-gray-800" %>
      </div>
    <% end %>
  </div>
<% end %>
