<%= render layout: "admin/shared/layout" do %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Application -->
    <div class="bg-white rounded-lg border border-gray-200">
      <div class="px-4 py-3 border-b border-gray-200">
        <h3 class="text-sm font-semibold text-gray-700">Application</h3>
      </div>
      <dl class="divide-y divide-gray-200">
        <% [
          ["Ruby", @ruby_version],
          ["Rails", @rails_version],
          ["Environment", @app_stats[:environment].capitalize],
          ["Time Zone", @app_stats[:time_zone]],
          ["PID", @app_stats[:pid]],
          ["Memory", "#{@app_stats[:memory_mb]} MB"],
        ].each do |label, value| %>
          <div class="px-4 py-3 flex justify-between">
            <dt class="text-sm text-gray-500"><%= label %></dt>
            <dd class="text-sm text-gray-900 font-mono"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <!-- Database -->
    <div class="bg-white rounded-lg border border-gray-200">
      <div class="px-4 py-3 border-b border-gray-200">
        <h3 class="text-sm font-semibold text-gray-700">Database</h3>
      </div>
      <dl class="divide-y divide-gray-200">
        <% [
          ["Adapter", @database[:adapter]],
          ["Version", @database[:version]],
          ["Size", @database[:size]],
          ["Journal Mode", @database[:journal_mode]&.upcase],
          ["Path", @database[:path]],
        ].each do |label, value| %>
          <div class="px-4 py-3 flex justify-between">
            <dt class="text-sm text-gray-500"><%= label %></dt>
            <dd class="text-sm text-gray-900 font-mono truncate ml-4 max-w-xs text-right"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <!-- Storage -->
    <div class="bg-white rounded-lg border border-gray-200">
      <div class="px-4 py-3 border-b border-gray-200">
        <h3 class="text-sm font-semibold text-gray-700">Storage</h3>
      </div>
      <dl class="divide-y divide-gray-200">
        <% [
          ["Files", @storage[:total_files]],
          ["Total Size", @storage[:total_size]],
          ["Path", @storage[:path]],
        ].each do |label, value| %>
          <div class="px-4 py-3 flex justify-between">
            <dt class="text-sm text-gray-500"><%= label %></dt>
            <dd class="text-sm text-gray-900 font-mono truncate ml-4 max-w-xs text-right"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <!-- Background Jobs -->
    <div class="bg-white rounded-lg border border-gray-200">
      <div class="px-4 py-3 border-b border-gray-200">
        <h3 class="text-sm font-semibold text-gray-700">Background Jobs (Solid Queue)</h3>
      </div>
      <% if @job_stats[:total_jobs] %>
        <dl class="divide-y divide-gray-200">
          <% [
            ["Total Jobs", @job_stats[:total_jobs]],
            ["Ready", @job_stats[:ready]],
            ["Scheduled", @job_stats[:scheduled]],
            ["Claimed", @job_stats[:claimed]],
            ["Failed", @job_stats[:failed]],
          ].each do |label, value| %>
            <% next if value.nil? %>
            <div class="px-4 py-3 flex justify-between">
              <dt class="text-sm text-gray-500"><%= label %></dt>
              <dd class="text-sm font-mono <%= label == 'Failed' && value.to_i > 0 ? 'text-red-600 font-medium' : 'text-gray-900' %>">
                <%= value %>
              </dd>
            </div>
          <% end %>
        </dl>
      <% else %>
        <div class="p-6 text-center">
          <p class="text-sm text-gray-400">Solid Queue tables not yet migrated.</p>
          <p class="text-xs text-gray-300 mt-1">Run <code class="bg-gray-100 px-1 py-0.5 rounded">bin/rails solid_queue:install:migrations</code> to enable.</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Table stats -->
  <div class="mt-6 bg-white rounded-lg border border-gray-200">
    <div class="px-4 py-3 border-b border-gray-200">
      <h3 class="text-sm font-semibold text-gray-700">Database Tables</h3>
    </div>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Table</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Rows</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @table_stats.each do |table| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-2 text-sm text-gray-900 font-mono"><%= table[:name] %></td>
            <td class="px-4 py-2 text-sm text-gray-600 text-right font-mono"><%= number_with_delimiter(table[:count]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
