<%= render layout: "admin/shared/layout" do %>
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold text-gray-900">API Tokens (<%= @tokens.count %>)</h2>
    <div class="flex items-center gap-2">
      <% [
        { label: "All", filter: nil },
        { label: "Active", filter: "active" },
        { label: "Revoked", filter: "revoked" },
      ].each do |btn| %>
        <%= link_to btn[:label], admin_api_tokens_path(filter: btn[:filter]),
            class: "px-3 py-1.5 text-sm rounded-lg #{
              params[:filter] == btn[:filter] || (btn[:filter].nil? && params[:filter].blank?) ?
                'bg-indigo-600 text-white' :
                'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50'
            }" %>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Token</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Owner</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last Used</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @tokens.each do |token| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <p class="text-sm font-medium text-gray-900"><%= token.name %></p>
              <p class="text-xs text-gray-400 font-mono"><%= token.prefix %>...</p>
            </td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full flex items-center justify-center text-white text-xs shrink-0"
                      style="background-color: <%= token.user.avatar_color %>">
                  <%= token.user.name.first.upcase %>
                </span>
                <span class="text-sm text-gray-700"><%= token.user.name %></span>
              </div>
            </td>
            <td class="px-4 py-3">
              <span class="px-2 py-0.5 text-xs rounded <%= token.active? ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500' %>">
                <%= token.active? ? "Active" : "Revoked" %>
              </span>
            </td>
            <td class="px-4 py-3 text-xs text-gray-400">
              <%= token.last_used_at ? "#{time_ago_in_words(token.last_used_at)} ago" : "Never" %>
            </td>
            <td class="px-4 py-3 text-xs text-gray-400">
              <%= token.created_at.strftime("%b %d, %Y") %>
            </td>
            <td class="px-4 py-3 text-right">
              <% if token.active? %>
                <%= button_to "Revoke", admin_api_token_path(token), method: :delete,
                    class: "text-sm text-red-600 hover:text-red-800",
                    data: { turbo_confirm: "Revoke this token? The owner will lose API access." } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @tokens.empty? %>
      <p class="p-8 text-center text-sm text-gray-400">No tokens found</p>
    <% end %>
  </div>
<% end %>
